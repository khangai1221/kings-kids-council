# =============================================================================
# YM Student Council Portal — environment variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="YM Student Council"
ALLOWED_EMAIL_DOMAIN=kingskids.mn
APP_TIMEZONE=Asia/Ulaanbaatar
NODE_ENV=development

# --- Clerk (authentication) --------------------------------------------------
# From https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From https://dashboard.clerk.com -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=
# From https://dashboard.clerk.com -> Configure -> Integrations -> Supabase
# (used by supabase/config.toml for local dev third-party auth; also
# configure this domain in the hosted Supabase dashboard's Third-Party Auth
# settings for staging/production). Looks like "your-app.clerk.accounts.dev".
CLERK_FRONTEND_API_DOMAIN=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Supabase (database, storage, realtime) ---------------------------------
# From https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client bundle or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed if you use the Supabase Management API from scripts.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Firebase (browser push notifications only) ------------------------------
# From https://console.firebase.google.com -> Project settings -> General -> Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From Project settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (server-only). From a service account JSON key file.
# IMPORTANT: FIREBASE_PRIVATE_KEY must keep its literal "\n" sequences when
# stored in a single-line env value. lib/firebase/admin.ts unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Resend (transactional email) --------------------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=
# Must be "onboarding@resend.dev" until a sending domain is verified in the
# Resend dashboard, after which this can become a real address on that domain.
EMAIL_FROM="YM Student Council <onboarding@resend.dev>"

# --- Feature flags / misc ----------------------------------------------------
# Firebase Analytics is prepared in code but disabled by default. Analytics
# must never carry names, emails, application answers or suggestion content.
NEXT_PUBLIC_ENABLE_FIREBASE_ANALYTICS=false
